@startuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam nodesep 30
skinparam ranksep 45
hide empty members
top to bottom direction

interface Element <<Element>> {
  +getName(): String
  +accept(Visitor): void
}

abstract class Node {
  -name: String
  -parent: DirectoryNode
}

class FileNode <<Concrete Element>> {
  -size: long
  +getSize(): long
  +accept(Visitor): void
}

class DirectoryNode <<Concrete Element>> {
  -children: List<Node>
  +addChild(Node): void
  +getChildren(): List<Node>
  +accept(Visitor): void
}

interface Visitor <<Visitor>> {
  +visit(FileNode): void
  +visit(DirectoryNode): void
}

class TotalSizeVisitor <<Concrete Visitor>> {
  -totalSize: long
  +calculate(Element): long
}

class SearchVisitor <<Concrete Visitor>> {
  -filenameCriterion: Predicate<String>
  -minimumSize: long
  +search(Element): List<String>
}

class StatisticsVisitor <<Concrete Visitor>> {
  -fileCount: int
  -directoryCount: int
  -maximumDepth: int
  +analyze(Element): void
  +getFileCount(): int
  +getDirectoryCount(): int
  +getMaximumDepth(): int
}

Element <|.. Node
Node <|-- FileNode
Node <|-- DirectoryNode
DirectoryNode *-right- Node : children (0..*)
Visitor <|.. TotalSizeVisitor
Visitor <|.. SearchVisitor
Visitor <|.. StatisticsVisitor
FileNode ..> Visitor : visit(this)
DirectoryNode ..> Visitor : visit(this)
@enduml
